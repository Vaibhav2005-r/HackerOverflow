/** Generates the demo community reports twice from one source: public/data/<city>/seed_reports.json (local mode) and supabase/seed.sql. */
import { readFileSync, writeFileSync } from "node:fs";
import { getH3, initH3 } from "../src/util/h3";
import { cellInfo, haversine, parseCellsFile, resample, type Band, type ReportCategory } from "../src/index";

await initH3();
const latLngToCell = (la: number, lo: number, r: number) => getH3().latLngToCell(la, lo, r);
const ROOT = new URL("../../../", import.meta.url).pathname;
const DATA = `${ROOT}apps/web/public/data/mumbai_demo/`;
const cells = parseCellsFile(JSON.parse(readFileSync(`${DATA}cells.json`, "utf8")));
const demo = JSON.parse(readFileSync(`${DATA}demo_routes.json`, "utf8")) as { presets: { routes: { coords: [number, number][] }[] }[] };

let seed = 20261010; // deterministic
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const pick = <T,>(a: T[]) => a[Math.floor(rnd() * a.length)]!;

// distinct cells the demo routes pass through, ~150 m apart
const along = new Map<string, number>();
for (const p of demo.presets) for (const r of p.routes) for (const s of resample(r.coords, 150)) {
  const h = latLngToCell(s.pt[1], s.pt[0], cells.res);
  if (cells.cells.has(h)) along.set(h, (along.get(h) ?? 0) + 1);
}
const list = [...along.keys()];
const NEG: ReportCategory[] = ["felt_unsafe", "poor_lighting", "no_help_nearby", "harassment"];
const POS: ReportCategory[] = ["well_lit", "helpful_people", "felt_safe"];
const BANDS: Band[] = ["evening", "night", "night"];

const rows: { h3: string; band: Band; category: ReportCategory; ageDays: number }[] = [];
const weak = list.filter((h) => cellInfo(cells.cells, h, "night")!.cls !== "COMFORTABLE");
const good = list.filter((h) => cellInfo(cells.cells, h, "night")!.cls === "COMFORTABLE");
for (let i = 0; i < 12 && weak.length; i++) rows.push({ h3: weak[i % weak.length]!, band: pick(BANDS), category: pick(NEG), ageDays: Math.ceil(rnd() * 40) });
for (let i = 0; i < 8 && good.length; i++) rows.push({ h3: pick(good), band: pick(BANDS), category: pick(POS), ageDays: Math.ceil(rnd() * 40) });
void haversine;

writeFileSync(`${DATA}seed_reports.json`, JSON.stringify(rows));

// supabase/seed.sql — seed reporters are plain auth.users rows (the table requires a reporter), 4 reports each
const users = Array.from({ length: Math.ceil(rows.length / 4) }, (_, i) => `00000000-0000-4000-8000-0000000000${String(i + 1).padStart(2, "0")}`);
const sql = [
  "-- Demo community reports (generated by packages/core/scripts/make-seed.mts — do not edit by hand).",
  "insert into auth.users (id, instance_id, aud, role, email, encrypted_password, email_confirmed_at, created_at, updated_at, raw_app_meta_data, raw_user_meta_data)",
  "values",
  users.map((u, i) => `  ('${u}', '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', 'seed${i + 1}@raksha.invalid', '', now(), now(), now(), '{"provider":"email","providers":["email"]}', '{}')`).join(",\n"),
  "on conflict (id) do nothing;",
  "",
  "insert into public.reports (reporter_id, h3_cell, band, category, created_at) values",
  rows.map((r, i) => `  ('${users[Math.floor(i / 4)]}', '${r.h3}', '${r.band}', '${r.category}', now() - interval '${r.ageDays} days')`).join(",\n") + ";",
  "",
].join("\n");
writeFileSync(`${ROOT}supabase/seed.sql`, sql);
console.log(`${rows.length} reports (${weak.length} weak cells, ${good.length} comfortable cells on the demo routes)`);
